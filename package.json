{
  "name": "nisabadb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run books:check && tsc -b && vite build && node scripts/copy-spa-fallback.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build",
    "content:validate": "vitest run src/data/content.test.ts",
    "books:sync": "node scripts/book-graph-files.mjs",
    "books:public-boundary": "node scripts/book-graph-publication-policy.mjs",
    "books:sources:sync": "node scripts/book-source-files.mjs",
    "books:sources:bootstrap": "node scripts/book-source-files.mjs --bootstrap-from-graphs",
    "books:sources:check": "node scripts/book-source-files.mjs --check && vitest run scripts/book-source-resolution.test.mjs",
    "books:check": "npm run books:public-boundary && node scripts/book-graph-files.mjs --check && node scripts/book-source-files.mjs --check && vitest run src/data/book-graph.test.ts scripts/book-source-resolution.test.mjs scripts/book-graph-publication-policy.test.mjs",
    "books:prune-placeholders": "node scripts/book-graph-files.mjs --remove-neutral-placeholders",
    "books:migrate-storage": "node scripts/migrate-book-graph-storage.mjs",
    "citations:snapshot": "node scripts/build-citation-snapshot.mjs",
    "citations:ingest": "node scripts/ingest-citations.mjs"
  },
  "dependencies": {
    "katex": "0.18.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.2",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/katex": "0.16.8",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "jsdom": "29.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.1"
  }
}
